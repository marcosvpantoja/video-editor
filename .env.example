# Nada é obrigatório: o app usa o Claude Code instalado e logado nesta máquina (sem API key),
# o Whisper local (npm run setup:whisper) e o Chrome local para prints.

# CLAUDE_MODEL=sonnet          # modelo usado pelo `claude -p` (sonnet | opus | id completo)
# CLAUDE_BIN=claude            # caminho do executável do Claude Code
# WHISPER_MODEL=small          # tiny | base | small | medium | large
# WHISPER_PYTHON=.venv-whisper/bin/python
# CHROME_PATH=/Applications/Google Chrome.app/Contents/MacOS/Google Chrome
